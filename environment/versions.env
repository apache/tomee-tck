# Reproducibility lock for the Jakarta EE 11 Web Profile runner.
#
# Keep the Maven properties in the root pom.xml aligned with these values.
# Snapshot checksums intentionally make an upstream rebuild fail verification
# until this lock is reviewed and updated.

JAKARTA_EE_VERSION=11.0.0
JAKARTA_TCK_VERSION=11.0.3
JAKARTA_TCK_ARQUILLIAN_VERSION=11.1.3
JAKARTA_TCK_BOM_URL=https://repo1.maven.org/maven2/jakarta/tck/artifacts-bom/11.0.3/artifacts-bom-11.0.3.pom
JAKARTA_TCK_BOM_SHA256=985dcc0dc5dd3ce99b24e910b089dfdefdb60bfac29750c2e314837b79edd55c

TOMEE_VERSION=11.0.0-SNAPSHOT
TOMEE_CLASSIFIER=webprofile
TOMEE_SNAPSHOT_REPOSITORY=https://repository.apache.org/content/groups/snapshots

# Exact snapshot files resolved on 2026-07-13. Maven still uses the
# 11.0.0-SNAPSHOT coordinate; verify-inputs.sh proves which bytes it resolved.
TOMEE_WEBPROFILE_BUILD=11.0.0-20260713.181038-359
