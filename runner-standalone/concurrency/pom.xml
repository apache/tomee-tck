<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.tomee.cts</groupId>
    <artifactId>runner-standalone</artifactId>
    <version>11.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>runner-standalone-concurrency</artifactId>
  <name>Jakarta Concurrency 3.1 TCK runner</name>
  <description>
    Runs the standalone Jakarta Concurrency 3.1 TCK (web group) against the
    TomEE distribution selected by tomee.classifier.
  </description>

  <properties>
    <concurrency.tck.version>3.1.1</concurrency.tck.version>
  </properties>

  <dependencies>
    <!-- TomEE remote Arquillian adapter and client-side runtime. -->
    <dependency>
      <groupId>org.apache.tomee</groupId>
      <artifactId>arquillian-tomee-remote</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.openwebbeans</groupId>
      <artifactId>openwebbeans-impl</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.arquillian.junit5</groupId>
      <artifactId>arquillian-junit5-container</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Deployment failures serialized by the server may reference Catalina
         classes; keep them resolvable on the client for readable reports. -->
    <dependency>
      <groupId>org.apache.tomcat</groupId>
      <artifactId>tomcat-catalina</artifactId>
      <version>${tomcat.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.enterprise.concurrent</groupId>
      <artifactId>jakarta.enterprise.concurrent-tck</artifactId>
      <version>${concurrency.tck.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The TCK packages the signature-test framework into its archives. -->
    <dependency>
      <groupId>jakarta.tck</groupId>
      <artifactId>sigtest-maven-plugin</artifactId>
      <version>2.6</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.shrinkwrap.resolver</groupId>
      <artifactId>shrinkwrap-resolver-impl-maven</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Inherit the shared TomEE/Derby container lifecycle. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skip>${tck.standalone.skip}</skip>
          <dependenciesToScan>
            <dependency>jakarta.enterprise.concurrent:jakarta.enterprise.concurrent-tck</dependency>
          </dependenciesToScan>
          <!-- The web group is the Web Profile selection of the TCK. -->
          <groups>web</groups>
          <reportNameSuffix>web</reportNameSuffix>
          <systemPropertyVariables>
            <jimage.dir>${project.build.directory}/jimage</jimage.dir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
