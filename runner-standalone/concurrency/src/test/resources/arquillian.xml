<?xml version="1.0" encoding="UTF-8"?>
<arquillian xmlns="http://jboss.org/schema/arquillian"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://jboss.org/schema/arquillian http://jboss.org/schema/arquillian/arquillian_1_0.xsd">
  <engine>
    <property name="deploymentExportPath">target/deployments</property>
  </engine>
  <container qualifier="tomee-remote" default="true">
    <configuration>
      <property name="groupId">org.apache.tomee</property>
      <property name="artifactId">apache-tomee</property>
      <property name="version">${tomee.version}</property>
      <property name="classifier">${tomee.classifier}</property>
      <property name="type">zip</property>
      <property name="conf">${project.build.directory}/tomee-overlay/conf</property>
      <property name="lib">${project.build.directory}/tomee-overlay/lib</property>
      <property name="host">localhost</property>
      <!-- The adapter reuses any server already answering on httpPort, so
           override tomee.http.port/tomee.shutdown.port to run next to
           another harness instance. -->
      <property name="httpPort">${tomee.http.port}</property>
      <property name="httpsPort">${tomee.https.port}</property>
      <property name="stopPort">${tomee.shutdown.port}</property>
      <property name="cleanOnStartUp">true</property>
      <property name="removeUnusedWebapps">true</property>
      <property name="simpleLog">true</property>
      <!-- The TCK's in-container signature test extracts the JDK image. -->
      <property name="catalina_opts">-Djimage.dir=${project.build.directory}/jimage --add-exports=java.base/jdk.internal.vm.annotation=ALL-UNNAMED</property>
      <!-- Declares the java:comp/Default* resource-env-refs (Concurrency
           §3.x.4.3 default resources) in every component namespace; without
           it the TCK's @Resource(lookup="java:comp/Default...") injections
           silently stay null (BuiltInEnvironmentEntries in openejb-core). -->
      <property name="properties">openejb.environment.default=true</property>
    </configuration>
  </container>
</arquillian>
