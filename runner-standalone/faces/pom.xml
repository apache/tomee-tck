<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.tomee.cts</groupId>
    <artifactId>runner-standalone</artifactId>
    <version>11.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>runner-standalone-faces</artifactId>
  <packaging>pom</packaging>
  <name>Jakarta Faces 4.1 TCK runner (modern modules + signature test)</name>
  <description>
    Runs the modern Arquillian modules of the Jakarta Faces 4.1 TCK
    (faces22/23/40/41 and util, roughly 319 tests) plus the
    faces-signaturetest module against TomEE Plume, which ships Mojarra.
    The signature test checks the Mojarra artifact TomEE bundles
    (faces.impl.version below must track the jakarta.faces jar in the
    distribution's lib directory). The legacy JavaTest old-tck half lives in
    runner-standalone-faces-old. Run with: run-standalone-suite.sh faces
  </description>

  <properties>
    <!-- The Faces implementation under test: org.glassfish:jakarta.faces as
         bundled in TomEE Plume's lib directory. Keep in sync with the TomEE
         distribution (lib/jakarta.faces-<version>.jar). -->
    <faces.impl.version>4.1.9</faces.impl.version>
    <!-- The TCK reactor starts its own server; skip the shared lifecycle. -->
    <tck.standalone.container.skip>true</tck.standalone.container.skip>
    <!-- Reviewed known-gap exclusions; point at exclusions/none.txt for a
         full baseline run. -->
    <tck.exclusions.file>${project.basedir}/../exclusions/faces.txt</tck.exclusions.file>
  </properties>

  <build>
    <plugins>
      <!-- Step 1: download, verify, unpack, and patch the TCK. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>download-tck</id>
            <phase>generate-test-resources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <skip>${tck.standalone.skip}</skip>
              <target>
                <get skipexisting="true" src="${faces.tck.url}" dest="${project.build.directory}/jakarta-faces-tck-${faces.tck.version}.zip"/>
                <checksum file="${project.build.directory}/jakarta-faces-tck-${faces.tck.version}.zip" algorithm="SHA-256" property="${faces.tck.sha256}" verifyProperty="faces.tck.checksum.matches"/>
                <fail message="Checksum mismatch for the Jakarta Faces TCK distribution">
                  <condition>
                    <isfalse value="${faces.tck.checksum.matches}"/>
                  </condition>
                </fail>
                <unzip src="${project.build.directory}/jakarta-faces-tck-${faces.tck.version}.zip" dest="${project.build.directory}/jakarta-faces-tck-${faces.tck.version}"/>

                <!-- Inject the tomee-remote profile into the TCK parent pom. -->
                <loadfile property="tomee.remote.profile" srcFile="${project.basedir}/src/test/resources/tomee-remote-profile.xml" encoding="UTF-8">
                  <filterchain>
                    <expandproperties/>
                  </filterchain>
                </loadfile>
                <replace file="${faces.tck.dir}/pom.xml" token="&lt;/profiles&gt;" value="${line.separator}${tomee.remote.profile}${line.separator} &lt;/profiles&gt;"/>

                <!-- Deactivate the GlassFish profile's default activation. -->
                <replace file="${faces.tck.dir}/pom.xml" token="&lt;activeByDefault&gt;true&lt;/activeByDefault&gt;" value="&lt;activeByDefault&gt;false&lt;/activeByDefault&gt;"/>

                <!-- The distribution references an unpublished API snapshot. -->
                <replace file="${faces.tck.dir}/pom.xml" token="&lt;faces.version&gt;4.1.3-SNAPSHOT&lt;/faces.version&gt;" value="&lt;faces.version&gt;4.1.2&lt;/faces.version&gt;"/>

                <!-- Anchor the Maven wrapper's multi-module root inside the
                     extracted TCK so its internal path properties resolve
                     against the TCK, not this repository. -->
                <mkdir dir="${faces.tck.dir}/.mvn"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Step 2: install the TCK parent pom and util module. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>install-tck-parent</id>
            <phase>pre-integration-test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${tck.standalone.skip}</skip>
              <executable>${maven.multiModuleProjectDirectory}/mvnw</executable>
              <workingDirectory>${faces.tck.dir}</workingDirectory>
              <arguments>
                <argument>-B</argument><argument>-ntp</argument>
                <argument>install</argument>
                <argument>-N</argument>
                <argument>-Ptomee-remote</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>install-tck-util</id>
            <phase>pre-integration-test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${tck.standalone.skip}</skip>
              <executable>${maven.multiModuleProjectDirectory}/mvnw</executable>
              <workingDirectory>${faces.tck.dir}/util</workingDirectory>
              <arguments>
                <argument>-B</argument><argument>-ntp</argument>
                <argument>install</argument>
                <argument>-Ptomee-remote</argument>
                <argument>-DskipTests</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Step 3: run the modern TCK modules through the Maven invoker. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-invoker-plugin</artifactId>
        <version>3.10.1</version>
        <configuration>
          <skipInvocation>${tck.standalone.skip}</skipInvocation>
          <projectsDirectory>${faces.tck.dir}</projectsDirectory>
          <localRepositoryPath>${settings.localRepository}</localRepositoryPath>
          <mavenExecutable>${maven.multiModuleProjectDirectory}/mvnw</mavenExecutable>
          <streamLogs>true</streamLogs>
          <showErrors>true</showErrors>
          <ignoreFailures>true</ignoreFailures>
        </configuration>
        <executions>
          <execution>
            <id>run-faces-tck</id>
            <phase>integration-test</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <goals><goal>verify</goal></goals>
              <profiles><profile>tomee-remote</profile></profiles>
              <!-- Each include is a multi-module reactor; collect the whole
                   baseline instead of stopping at the first failing module.
                   The reviewed exclusion list is applied inside every TCK
                   module's surefire/failsafe execution. -->
              <properties>
                <maven.test.failure.ignore>true</maven.test.failure.ignore>
                <surefire.excludesFile>${tck.exclusions.file}</surefire.excludesFile>
                <failsafe.excludesFile>${tck.exclusions.file}</failsafe.excludesFile>
              </properties>
              <pomIncludes>
                <pomInclude>faces22/pom.xml</pomInclude>
                <pomInclude>faces23/pom.xml</pomInclude>
                <pomInclude>faces40/pom.xml</pomInclude>
                <pomInclude>faces41/pom.xml</pomInclude>
                <pomInclude>faces-signaturetest/pom.xml</pomInclude>
              </pomIncludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
