<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.tomee.cts</groupId>
    <artifactId>runner-standalone</artifactId>
    <version>11.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>runner-standalone-cdi</artifactId>
  <name>Jakarta CDI 4.1 TCK runner (core)</name>
  <description>
    Runs the Jakarta Contexts and Dependency Injection 4.1 TCK core suite
    (which also carries the non-EJB Jakarta Interceptors 2.2 tests) against
    the TomEE distribution selected by tomee.classifier, using the Apache
    OpenWebBeans TCK porting package. The EE-integration half of the CDI and
    Interceptors TCKs lives in jakarta.tck:cdi-tck-ee-impl and runs through
    the cdi-ee sibling module.
  </description>

  <properties>
    <cdi.tck.version>4.1.0</cdi.tck.version>
    <testng.version>7.9.0</testng.version>
    <!-- Reviewed known-gap exclusions; -Dtck.exclusions.file=none for a
         full baseline run. -->
    <tck.exclusions.file>${project.basedir}/../exclusions/cdi.txt</tck.exclusions.file>
  </properties>

  <dependencies>
    <!-- TomEE remote Arquillian adapter and client-side runtime. -->
    <dependency>
      <groupId>org.apache.tomee</groupId>
      <artifactId>arquillian-tomee-remote</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.openwebbeans</groupId>
      <artifactId>openwebbeans-impl</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.enterprise</groupId>
      <artifactId>cdi-tck-core-impl</artifactId>
      <version>${cdi.tck.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.enterprise</groupId>
      <artifactId>cdi-tck-api</artifactId>
      <version>${cdi.tck.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Apache OpenWebBeans implementations of the org.jboss.cdi.tck.spi
         porting interfaces. -->
    <dependency>
      <groupId>org.apache.openwebbeans</groupId>
      <artifactId>openwebbeans-porting</artifactId>
      <version>${openwebbeans.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>${testng.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Applies the reviewed exclusion list to the TestNG suite run. -->
    <dependency>
      <groupId>org.apache.tomee.cts</groupId>
      <artifactId>runner-standalone-tck-common</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.arquillian.testng</groupId>
      <artifactId>arquillian-testng-container</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.shrinkwrap.descriptors</groupId>
      <artifactId>shrinkwrap-descriptors-impl-javaee</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.shrinkwrap.resolver</groupId>
      <artifactId>shrinkwrap-resolver-impl-maven</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Inherit the shared TomEE/Derby container lifecycle. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>stage-cdi-tck-suite</id>
            <phase>generate-test-resources</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <skip>${tck.standalone.skip}</skip>
              <artifactItems>
                <artifactItem>
                  <groupId>jakarta.enterprise</groupId>
                  <artifactId>cdi-tck-core-impl</artifactId>
                  <version>${cdi.tck.version}</version>
                  <classifier>suite</classifier>
                  <type>xml</type>
                  <destFileName>tck-core-suite.xml</destFileName>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}/suites</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>stage-cdi-tck-ext-lib</id>
            <phase>generate-test-resources</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <skip>${tck.standalone.skip}</skip>
              <artifactItems>
                <artifactItem>
                  <groupId>jakarta.enterprise</groupId>
                  <artifactId>cdi-tck-ext-lib</artifactId>
                  <version>${cdi.tck.version}</version>
                </artifactItem>
              </artifactItems>
              <!-- The TCK requires this helper library in a server library
                   directory visible to every deployed application. -->
              <outputDirectory>${project.build.directory}/tomee-overlay/lib</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>stage-library-directory</id>
            <phase>generate-test-resources</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <skip>${tck.standalone.skip}</skip>
              <artifactItems>
                <!-- The TCK archive builder bundles every jar found in
                     org.jboss.cdi.tck.libraryDirectory into each deployed
                     test application, which keeps the porting SPI classes in
                     the same class loader as the TCK support library. -->
                <artifactItem>
                  <groupId>org.apache.openwebbeans</groupId>
                  <artifactId>openwebbeans-porting</artifactId>
                  <version>${openwebbeans.version}</version>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}/dependency/lib</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skip>${tck.standalone.skip}</skip>
          <suiteXmlFiles>
            <suiteXmlFile>${project.build.directory}/suites/tck-core-suite.xml</suiteXmlFile>
          </suiteXmlFiles>
          <dependenciesToScan>
            <dependency>jakarta.enterprise:cdi-tck-core-impl</dependency>
          </dependenciesToScan>
          <!-- Web Profile selection per the CDI TCK configuration guide. -->
          <excludedGroups>javaee-full,se</excludedGroups>
          <!-- Suite-XML runs ignore excludesFile; the transformer listener
               applies the reviewed exclusion list instead. -->
          <properties>
            <property>
              <name>listener</name>
              <value>org.apache.tomee.tck.standalone.ExclusionsAnnotationTransformer</value>
            </property>
          </properties>
          <systemPropertyVariables>
            <org.jboss.cdi.tck.libraryDirectory>${project.build.directory}/dependency/lib</org.jboss.cdi.tck.libraryDirectory>
            <org.jboss.cdi.tck.testDataSource>openejb:Resource/jdbc/DB1</org.jboss.cdi.tck.testDataSource>
            <tck.exclusions.file>${tck.exclusions.file}</tck.exclusions.file>
          </systemPropertyVariables>
        </configuration>
        <dependencies>
          <!-- The CDI TCK is TestNG-based; prevent surefire from choosing
               the JUnit Platform provider brought in by the shared parent. -->
          <dependency>
            <groupId>org.apache.maven.surefire</groupId>
            <artifactId>surefire-testng</artifactId>
            <version>${maven.surefire.plugin.version}</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>
</project>
