<?xml version="1.0" encoding="UTF-8"?>
<arquillian xmlns="http://jboss.org/schema/arquillian"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://jboss.org/schema/arquillian http://jboss.org/schema/arquillian/arquillian_1_0.xsd">
  <engine>
    <property name="deploymentExportPath">target/deployments</property>
  </engine>
  <container qualifier="tomee-remote" default="true">
    <configuration>
      <property name="groupId">org.apache.tomee</property>
      <property name="artifactId">apache-tomee</property>
      <property name="version">${tomee.version}</property>
      <property name="classifier">${tomee.classifier}</property>
      <property name="type">zip</property>
      <property name="conf">${project.build.directory}/tomee-overlay/conf</property>
      <property name="lib">${project.build.directory}/tomee-overlay/lib</property>
      <property name="host">localhost</property>
      <property name="httpPort">8080</property>
      <property name="stopPort">8005</property>
      <property name="cleanOnStartUp">true</property>
      <property name="removeUnusedWebapps">true</property>
      <property name="simpleLog">true</property>
      <!-- The suite deploys and undeploys hundreds of archives in one server
           lifetime; size the heap like the reference runner. -->
      <property name="catalina_opts">-Xmx2048m -XX:MaxMetaspaceSize=1g --add-exports=java.base/jdk.internal.vm.annotation=ALL-UNNAMED</property>
      <!-- CDI TCK tuning lives in src/tomee-conf/system.properties, which
           replaces the shared overlay system.properties for this module.
           The porting SPI implementations reach each deployment through
           org.jboss.cdi.tck.libraryDirectory. -->
    </configuration>
  </container>
</arquillian>
