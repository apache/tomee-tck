<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.tomee.cts</groupId>
    <artifactId>runner-standalone</artifactId>
    <version>11.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>runner-standalone-rest-install</artifactId>
  <packaging>pom</packaging>
  <name>Jakarta RESTful Web Services 4.0 TCK installer</name>
  <description>
    Downloads the EFTL Jakarta RESTful Web Services TCK distribution and
    installs the jakarta.ws.rs:jakarta-restful-ws-tck artifact into the local
    repository. The same jar is also published on Maven Central under these
    coordinates, but the harness convention is to consume the official EFTL
    zip with a pinned SHA-256 so the certification input is the exact
    distribution Eclipse publishes.
  </description>

  <properties>
    <rest.tck.version>4.0.1</rest.tck.version>
    <rest.tck.zip>jakarta-restful-ws-tck-${rest.tck.version}.zip</rest.tck.zip>
    <rest.tck.url>https://download.eclipse.org/jakartaee/restful-ws/4.0/${rest.tck.zip}</rest.tck.url>
    <!-- From ${rest.tck.url}.sha256 -->
    <rest.tck.sha256>b6290c1b5b3d2fdd9cc700a999243492a7e27b94a9b6af1974ff4dc5bfbf98f2</rest.tck.sha256>
  </properties>

  <!-- The download/install work only happens in TCK mode: install-file has
       no skip parameter, so binding it in the default build would break a
       fresh checkout's plain reactor. -->
  <profiles>
    <profile>
      <id>standalone-tck</id>
      <activation>
        <property>
          <name>tck.standalone</name>
          <value>true</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>com.googlecode.maven-download-plugin</groupId>
            <artifactId>download-maven-plugin</artifactId>
            <version>1.13.0</version>
            <executions>
              <execution>
                <id>download-rest-tck</id>
                <phase>generate-resources</phase>
                <goals><goal>wget</goal></goals>
                <configuration>
                  <skip>${tck.standalone.skip}</skip>
                  <url>${rest.tck.url}</url>
                  <sha256>${rest.tck.sha256}</sha256>
                  <unpack>true</unpack>
                  <outputDirectory>${project.build.directory}</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-install-plugin</artifactId>
            <version>3.1.4</version>
            <executions>
              <execution>
                <id>install-rest-tck</id>
                <phase>process-resources</phase>
                <goals><goal>install-file</goal></goals>
                <configuration>
                  <skip>${tck.standalone.skip}</skip>
                  <!-- The distribution ships no standalone pom for the artifact
                       (only the one embedded in the jar, whose parent is the
                       jakarta.ws.rs:all reactor); generate a plain pom and let
                       the runner declare the dependencies explicitly. -->
                  <file>${project.build.directory}/restful-ws-tck/artifacts/jakarta-restful-ws-tck-${rest.tck.version}.jar</file>
                  <groupId>jakarta.ws.rs</groupId>
                  <artifactId>jakarta-restful-ws-tck</artifactId>
                  <version>${rest.tck.version}</version>
                  <packaging>jar</packaging>
                  <generatePom>true</generatePom>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
