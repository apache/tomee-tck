<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.tomee.cts</groupId>
    <artifactId>tomee-jakartaee11-tck</artifactId>
    <version>11.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>runner-standalone</artifactId>
  <packaging>pom</packaging>
  <name>Standalone Jakarta EE 11 specification TCK runners</name>
  <description>
    One runner module per independently published specification TCK required
    for Jakarta EE 11 Web Profile certification. The default build compiles
    the modules but runs no TCK; use run-standalone-suite.sh or
    -Dtck.standalone=true on a single module.
  </description>

  <modules>
    <module>tck-common</module>
    <module>annotations-install</module>
    <module>annotations</module>
    <module>concurrency</module>
    <module>data</module>
    <module>di-install</module>
    <module>di</module>
    <module>el-install</module>
    <module>el</module>
    <module>cdi-tck-porting</module>
    <module>cdi</module>
    <module>cdi-ee</module>
    <module>servlet-install</module>
    <module>servlet</module>
    <module>pages-install</module>
    <module>pages</module>
    <module>rest-install</module>
    <module>rest</module>
    <module>validation-install</module>
    <module>validation</module>
    <module>websocket-install</module>
    <module>websocket</module>
    <module>jsonp</module>
    <module>jsonb</module>
    <module>debugging-install</module>
    <module>debugging</module>
    <module>persistence-install</module>
    <module>persistence</module>
    <module>transactions</module>
    <module>security</module>
    <module>authentication</module>
    <module>faces</module>
    <module>faces-old</module>
    <module>security-old</module>
  </modules>

  <properties>
    <!-- TCK execution is opt-in (-Dtck.standalone=true activates the
         standalone-tck profile); the default reactor must stay fast. -->
    <tck.standalone.skip>true</tck.standalone.skip>
    <!-- Modules that only run local signature checks set this to true. -->
    <tck.standalone.container.skip>${tck.standalone.skip}</tck.standalone.container.skip>
    <!-- Guards the TomEE ports at validate; modules that stage but never
         start TomEE (persistence) override this to true. -->
    <tck.tomee.ports.guard.skip>${tck.standalone.container.skip}</tck.tomee.ports.guard.skip>
    <!-- Harness catalog defaults for the TomEE container; the remote
         adapter otherwise attaches to whatever already answers on the http
         port. run-standalone-suite.sh selects free values when the defaults
         are busy and passes them as -D overrides. Modules that pin fixed
         ports simply ignore these. -->
    <tomee.http.port>8080</tomee.http.port>
    <tomee.https.port>8443</tomee.https.port>
    <tomee.shutdown.port>8005</tomee.shutdown.port>
    <!-- Faces TCK distribution shared by the faces and faces-old runners;
         both halves must test the same zip. -->
    <faces.tck.version>4.1.2</faces.tck.version>
    <faces.tck.url>https://download.eclipse.org/jakartaee/faces/4.1/jakarta-faces-tck-${faces.tck.version}.zip</faces.tck.url>
    <faces.tck.sha256>0827e2c9c635940643aaefb2a2f063959b0cab2fa1d633a7008b9fa04c5109de</faces.tck.sha256>
    <faces.tck.dir>${project.build.directory}/jakarta-faces-tck-${faces.tck.version}/faces-tck-${faces.tck.version}/tck</faces.tck.dir>
    <!-- Ant pin for the JavaTest-driven runners (faces-old, transactions);
         the version the old-tck build/run poms and harness scripts are
         known to work with. -->
    <tck.ant.version>1.10.2</tck.ant.version>
    <tck.ant.home>${project.build.directory}/apache-ant-${tck.ant.version}</tck.ant.home>
    <tck.ant.url>https://archive.apache.org/dist/ant/binaries/apache-ant-${tck.ant.version}-bin.zip</tck.ant.url>
    <tck.ant.sha512>2b6b3b1769a38e0037c8f3825ffeb2094fbb2985128f3b03d1b10d792e75850d13cf04513a0c59a8ca89f1a446ca509def0bd5c2f2644f51054f56f2007a29d9</tck.ant.sha512>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Derby network server for the shared datasource environment. -->
    <dependency>
      <groupId>org.apache.derby</groupId>
      <artifactId>derbyclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.derby</groupId>
      <artifactId>derbyshared</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.derby</groupId>
      <artifactId>derbytools</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.derby</groupId>
      <artifactId>derbynet</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
        <filtering>true</filtering>
      </testResource>
    </testResources>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <executions>
            <execution>
              <id>stage-tomee-configuration</id>
              <phase>generate-test-resources</phase>
              <goals><goal>copy-resources</goal></goals>
              <configuration>
                <skip>${tck.standalone.container.skip}</skip>
                <overwrite>true</overwrite>
                <outputDirectory>${project.build.directory}/tomee-overlay/conf</outputDirectory>
                <resources>
                  <!-- Filtering substitutes ${tck.derby.port} in tomee.xml. -->
                  <resource>
                    <directory>${maven.multiModuleProjectDirectory}/environment/tomee/conf</directory>
                    <filtering>true</filtering>
                  </resource>
                  <!-- Optional module-specific configuration overrides; these
                       are copied last and replace same-named shared files. -->
                  <resource>
                    <directory>${project.basedir}/src/tomee-conf</directory>
                    <filtering>true</filtering>
                  </resource>
                </resources>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <executions>
            <execution>
              <id>resolve-tomee-distribution</id>
              <phase>generate-test-resources</phase>
              <goals><goal>get</goal></goals>
              <configuration>
                <skip>${tck.standalone.container.skip}</skip>
                <artifact>org.apache.tomee:apache-tomee:${tomee.version}:zip:${tomee.classifier}</artifact>
                <transitive>false</transitive>
              </configuration>
            </execution>
            <execution>
              <id>stage-derby-client</id>
              <phase>generate-test-resources</phase>
              <goals><goal>copy-dependencies</goal></goals>
              <configuration>
                <skip>${tck.standalone.container.skip}</skip>
                <includeGroupIds>org.apache.derby</includeGroupIds>
                <includeArtifactIds>derbyclient,derbyshared,derbytools</includeArtifactIds>
                <includeScope>test</includeScope>
                <outputDirectory>${project.build.directory}/tomee-overlay/lib</outputDirectory>
                <overWriteIfNewer>true</overWriteIfNewer>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <executions>
            <execution>
              <id>reset-generated-test-environment</id>
              <phase>initialize</phase>
              <goals><goal>exec</goal></goals>
              <configuration>
                <skip>${tck.standalone.container.skip}</skip>
                <executable>sh</executable>
                <arguments>
                  <argument>${maven.multiModuleProjectDirectory}/environment/reset-generated-test-environment.sh</argument>
                  <argument>${project.build.directory}/tomee-overlay</argument>
                  <argument>${project.build.directory}/derby</argument>
                </arguments>
              </configuration>
            </execution>
            <execution>
              <id>require-free-derby-port</id>
              <phase>validate</phase>
              <goals><goal>exec</goal></goals>
              <configuration>
                <skip>${tck.standalone.container.skip}</skip>
                <executable>sh</executable>
                <arguments>
                  <argument>${maven.multiModuleProjectDirectory}/environment/database/require-derby-port-free.sh</argument>
                  <argument>${java.home}/bin/java</argument>
                  <classpath/>
                  <argument>${tck.derby.port}</argument>
                </arguments>
                <classpathScope>test</classpathScope>
              </configuration>
            </execution>
            <execution>
              <id>require-free-tomee-ports</id>
              <phase>validate</phase>
              <goals><goal>exec</goal></goals>
              <configuration>
                <skip>${tck.tomee.ports.guard.skip}</skip>
                <executable>sh</executable>
                <arguments>
                  <argument>${maven.multiModuleProjectDirectory}/environment/tomee/require-tomee-ports-free.sh</argument>
                  <argument>${tomee.http.port}</argument>
                  <argument>${tomee.https.port}</argument>
                  <argument>${tomee.shutdown.port}</argument>
                </arguments>
              </configuration>
            </execution>
            <execution>
              <id>generate-test-certificates</id>
              <phase>generate-test-resources</phase>
              <goals><goal>exec</goal></goals>
              <configuration>
                <skip>${tck.standalone.container.skip}</skip>
                <executable>sh</executable>
                <arguments>
                  <argument>${maven.multiModuleProjectDirectory}/environment/certificates/generate-test-certificates.sh</argument>
                  <argument>${project.build.directory}/tomee-overlay/conf</argument>
                </arguments>
              </configuration>
            </execution>
            <execution>
              <id>start-derby</id>
              <phase>process-test-classes</phase>
              <goals><goal>exec</goal></goals>
              <configuration>
                <skip>${tck.standalone.container.skip}</skip>
                <executable>${java.home}/bin/java</executable>
                <classpathScope>test</classpathScope>
                <async>true</async>
                <asyncDestroyOnShutdown>true</asyncDestroyOnShutdown>
                <arguments>
                  <argument>-Dderby.system.home=${project.build.directory}/derby</argument>
                  <!-- The port travels as a system property because
                       exec-maven-plugin swallows the value after a literal
                       -p argument (module-path handling). -->
                  <argument>-Dderby.drda.portNumber=${tck.derby.port}</argument>
                  <argument>-cp</argument>
                  <classpath/>
                  <argument>org.apache.derby.drda.NetworkServerControl</argument>
                  <argument>start</argument>
                  <argument>-h</argument><argument>localhost</argument>
                  <argument>-noSecurityManager</argument>
                </arguments>
              </configuration>
            </execution>
            <execution>
              <id>wait-for-derby</id>
              <phase>process-test-classes</phase>
              <goals><goal>exec</goal></goals>
              <configuration>
                <skip>${tck.standalone.container.skip}</skip>
                <executable>sh</executable>
                <arguments>
                  <argument>${maven.multiModuleProjectDirectory}/environment/database/wait-for-derby.sh</argument>
                  <argument>${java.home}/bin/java</argument>
                  <classpath/>
                  <argument>${tck.derby.port}</argument>
                </arguments>
                <classpathScope>test</classpathScope>
              </configuration>
            </execution>
            <execution>
              <id>stop-derby</id>
              <phase>prepare-package</phase>
              <goals><goal>exec</goal></goals>
              <configuration>
                <skip>${tck.standalone.container.skip}</skip>
                <executable>${java.home}/bin/java</executable>
                <classpathScope>test</classpathScope>
                <arguments>
                  <argument>-Dderby.drda.portNumber=${tck.derby.port}</argument>
                  <argument>-cp</argument>
                  <classpath/>
                  <argument>org.apache.derby.drda.NetworkServerControl</argument>
                  <argument>shutdown</argument>
                  <argument>-h</argument><argument>localhost</argument>
                </arguments>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven.surefire.plugin.version}</version>
          <configuration>
            <skip>${tck.standalone.skip}</skip>
            <trimStackTrace>false</trimStackTrace>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <profile>
      <id>standalone-tck</id>
      <activation>
        <property>
          <name>tck.standalone</name>
          <value>true</value>
        </property>
      </activation>
      <properties>
        <tck.standalone.skip>false</tck.standalone.skip>
      </properties>
    </profile>
  </profiles>
</project>
