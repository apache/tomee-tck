<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.tomee.cts</groupId>
    <artifactId>runner-standalone</artifactId>
    <version>11.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>runner-standalone-validation</artifactId>
  <name>Jakarta Validation 3.1 TCK runner</name>
  <description>
    Runs the standalone Jakarta Validation 3.1 TCK against the TomEE
    distribution selected by tomee.classifier, with Apache BVal as the
    provider under test.
  </description>

  <properties>
    <validation.tck.version>3.1.1</validation.tck.version>
    <!-- Defaults match the fixed harness catalog; override to run beside
         another TomEE instance (the remote adapter attaches to any server
         already answering on the http port). -->
    <tomee.http.port>8080</tomee.http.port>
    <tomee.shutdown.port>8005</tomee.shutdown.port>
    <cdi.tck.version>4.1.0</cdi.tck.version>
    <testng.version>7.9.0</testng.version>
    <!-- The Jakarta Validation provider shipped by TomEE. -->
    <validation.provider>org.apache.bval.jsr.ApacheValidationProvider</validation.provider>
    <!-- Reviewed known-gap exclusions; -Dtck.exclusions.file=none for a
         full baseline run. -->
    <tck.exclusions.file>${project.basedir}/../exclusions/validation.txt</tck.exclusions.file>
  </properties>

  <dependencies>
    <!-- TomEE remote Arquillian adapter and client-side runtime. -->
    <dependency>
      <groupId>org.apache.tomee</groupId>
      <artifactId>arquillian-tomee-remote</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.openwebbeans</groupId>
      <artifactId>openwebbeans-impl</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- TestNG listeners referenced from suite.xml. -->
    <dependency>
      <groupId>jakarta.enterprise</groupId>
      <artifactId>cdi-tck-core-impl</artifactId>
      <version>${cdi.tck.version}</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>jakarta.tck</groupId>
          <artifactId>audit</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- The published TCK jar is compiled against the old ListAssert
         covariant signatures; 3.7.0 is the version the reference runner
         pins for exactly this reason. -->
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.7.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>${testng.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Applies the reviewed exclusion list to the TestNG suite run. -->
    <dependency>
      <groupId>org.apache.tomee.cts</groupId>
      <artifactId>runner-standalone-tck-common</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.arquillian.testng</groupId>
      <artifactId>arquillian-testng-container</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.shrinkwrap.resolver</groupId>
      <artifactId>shrinkwrap-resolver-impl-maven</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Inherit the shared TomEE/Derby container lifecycle. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skip>${tck.standalone.skip}</skip>
          <suiteXmlFiles>
            <suiteXmlFile>${project.basedir}/suite.xml</suiteXmlFile>
          </suiteXmlFiles>
          <dependenciesToScan>
            <dependency>jakarta.validation:validation-tck-tests</dependency>
          </dependenciesToScan>
          <!-- Suite-XML runs ignore excludesFile; the transformer listener
               applies the reviewed exclusion list instead. -->
          <properties>
            <property>
              <name>listener</name>
              <value>org.apache.tomee.tck.standalone.ExclusionsAnnotationTransformer</value>
            </property>
          </properties>
          <systemPropertyVariables>
            <validation.provider>${validation.provider}</validation.provider>
            <tck.exclusions.file>${tck.exclusions.file}</tck.exclusions.file>
          </systemPropertyVariables>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.apache.maven.surefire</groupId>
            <artifactId>surefire-testng</artifactId>
            <version>${maven.surefire.plugin.version}</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <!-- These artifacts come from the EFTL distribution installed by the
           matching -install module; keep them out of the default reactor so
           a fresh clone builds without running any TCK. -->
      <id>standalone-tck</id>
      <activation>
        <property>
          <name>tck.standalone</name>
          <value>true</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>jakarta.validation</groupId>
          <artifactId>validation-tck-tests</artifactId>
          <version>${validation.tck.version}</version>
          <scope>test</scope>
        </dependency>

      </dependencies>
    </profile>
  </profiles>
</project>

