<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.tomee.cts</groupId>
    <artifactId>runner-standalone</artifactId>
    <version>11.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>runner-standalone-servlet</artifactId>
  <name>Jakarta Servlet 6.1 TCK runner</name>
  <description>
    Runs the standalone Jakarta Servlet 6.1 TCK against the TomEE
    distribution selected by tomee.classifier. The TCK's bundled client
    certificate is trusted by the server connector, and its identity is
    mapped to the required role through a sun-web.xml added by an Arquillian
    archive processor.
  </description>

  <properties>
    <servlet.tck.version>6.1.0</servlet.tck.version>
    <!-- Defaults match the fixed harness catalog; override to run beside
         another TomEE instance (the remote adapter attaches to any server
         already answering on the http port). -->
    <tomee.http.port>8080</tomee.http.port>
    <tomee.https.port>8443</tomee.https.port>
    <tomee.shutdown.port>8005</tomee.shutdown.port>
    <!-- Reviewed known-gap exclusions; point at exclusions/none.txt for a
         full baseline run. -->
    <tck.exclusions.file>${project.basedir}/../exclusions/servlet.txt</tck.exclusions.file>
  </properties>

  <dependencies>
    <!-- TomEE remote Arquillian adapter and client-side runtime. -->
    <dependency>
      <groupId>org.apache.tomee</groupId>
      <artifactId>arquillian-tomee-remote</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.openwebbeans</groupId>
      <artifactId>openwebbeans-impl</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.arquillian.junit5</groupId>
      <artifactId>arquillian-junit5-container</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.tck</groupId>
      <artifactId>sigtest-maven-plugin</artifactId>
      <version>2.6</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.shrinkwrap.resolver</groupId>
      <artifactId>shrinkwrap-resolver-impl-maven</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The TCK's CommonServlets resolves org.slf4j:slf4j-simple at the
         version of the slf4j-api present on the class path (1.7.36 from the
         TomEE adapter), so exactly that version must be resolvable. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>1.7.36</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Inherit the shared TomEE/Derby container lifecycle. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>stage-tomee-api-jar</id>
            <phase>generate-test-resources</phase>
            <goals><goal>unpack</goal></goals>
            <configuration>
              <skip>${tck.standalone.skip}</skip>
              <artifactItems>
                <artifactItem>
                  <groupId>org.apache.tomee</groupId>
                  <artifactId>apache-tomee</artifactId>
                  <version>${tomee.version}</version>
                  <classifier>${tomee.classifier}</classifier>
                  <type>zip</type>
                  <outputDirectory>${project.build.directory}/tomee</outputDirectory>
                  <includes>**/lib/servlet-api.jar</includes>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
          <execution>
            <id>stage-tck-client-certificates</id>
            <phase>generate-test-resources</phase>
            <goals><goal>unpack</goal></goals>
            <configuration>
              <skip>${tck.standalone.skip}</skip>
              <artifactItems>
                <!-- The TCK hardcodes the identity of its bundled client
                     certificate (CN=CTS, OU=Java Software, ...), so the
                     bundled keystore must be used, not a generated one. -->
                <artifactItem>
                  <groupId>jakarta.tck</groupId>
                  <artifactId>servlet-tck-runtime</artifactId>
                  <version>${servlet.tck.version}</version>
                  <outputDirectory>${project.build.directory}</outputDirectory>
                  <includes>certificates/**</includes>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>locate-servlet-api-jar</id>
            <phase>generate-test-resources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <skip>${tck.standalone.skip}</skip>
              <exportAntProperties>true</exportAntProperties>
              <target>
                <path id="servlet-api-jar">
                  <fileset dir="${project.build.directory}/tomee">
                    <include name="**/lib/servlet-api.jar"/>
                  </fileset>
                </path>
                <pathconvert pathsep="${path.separator}"
                             property="servlet.sig.api.jar"
                             refid="servlet-api-jar"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>trust-tck-client-certificate</id>
            <phase>generate-test-resources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${tck.standalone.skip}</skip>
              <executable>${java.home}/bin/keytool</executable>
              <arguments>
                <argument>-importcert</argument>
                <argument>-noprompt</argument>
                <argument>-alias</argument><argument>tckcts</argument>
                <argument>-file</argument><argument>${project.build.directory}/certificates/cts_cert</argument>
                <argument>-keystore</argument><argument>${project.build.directory}/tomee-overlay/conf/server-truststore.p12</argument>
                <argument>-storetype</argument><argument>PKCS12</argument>
                <argument>-storepass</argument><argument>changeit</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skip>${tck.standalone.skip}</skip>
          <argLine>-Duser.language=en -Duser.country=US -Djava.locale.providers=COMPAT,CLDR</argLine>
          <dependenciesToScan>
            <dependency>jakarta.tck:servlet-tck-runtime</dependency>
          </dependenciesToScan>
          <excludesFile>${tck.exclusions.file}</excludesFile>
          <systemPropertyVariables>
            <servlet.tck.support.crossContext>false</servlet.tck.support.crossContext>
            <servlet.tck.support.http2Push>false</servlet.tck.support.http2Push>
            <servlet.tck.slf4jimpl>org.slf4j:slf4j-simple</servlet.tck.slf4jimpl>
            <javax.net.ssl.keyStore>${project.build.directory}/certificates/clientcert.jks</javax.net.ssl.keyStore>
            <javax.net.ssl.keyStorePassword>changeit</javax.net.ssl.keyStorePassword>
            <javax.net.ssl.keyStoreType>JKS</javax.net.ssl.keyStoreType>
            <securedWebServicePort>${tomee.https.port}</securedWebServicePort>
            <servlet.tck.httpsPort>${tomee.https.port}</servlet.tck.httpsPort>
            <javax.net.ssl.trustStore>${project.build.directory}/tomee-overlay/conf/client-truststore.p12</javax.net.ssl.trustStore>
            <javax.net.ssl.trustStorePassword>changeit</javax.net.ssl.trustStorePassword>
            <javax.net.ssl.trustStoreType>PKCS12</javax.net.ssl.trustStoreType>
            <!-- TLSv1.3 post-handshake auth breaks the client-cert tests. -->
            <jdk.tls.client.protocols>TLSv1.2</jdk.tls.client.protocols>
            <jimage.dir>${project.build.directory}/jimage</jimage.dir>
            <sigTestClasspath>${servlet.sig.api.jar}${path.separator}${project.build.directory}/jimage/java.base${path.separator}${project.build.directory}/jimage/java.rmi${path.separator}${project.build.directory}/jimage/java.sql${path.separator}${project.build.directory}/jimage/java.naming</sigTestClasspath>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <!-- These artifacts come from the EFTL distribution installed by the
           matching -install module; keep them out of the default reactor so
           a fresh clone builds without running any TCK. -->
      <id>standalone-tck</id>
      <activation>
        <property>
          <name>tck.standalone</name>
          <value>true</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>jakarta.tck</groupId>
          <artifactId>servlet-tck-runtime</artifactId>
          <version>${servlet.tck.version}</version>
          <scope>test</scope>
        </dependency>

        <dependency>
          <groupId>jakarta.tck</groupId>
          <artifactId>servlet-tck-util</artifactId>
          <version>${servlet.tck.version}</version>
          <scope>test</scope>
        </dependency>

      </dependencies>
    </profile>
  </profiles>
</project>

