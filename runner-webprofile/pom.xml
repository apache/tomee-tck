<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.tomee.cts</groupId>
    <artifactId>tomee-jakartaee11-tck</artifactId>
    <version>11.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>runner-webprofile</artifactId>
  <packaging>pom</packaging>
  <name>TomEE Jakarta EE 11 Web Profile TCK runners</name>

  <!-- Activating one artifact per reactor keeps classpaths and reports isolated. -->
  <profiles>
    <profile>
      <id>selected-platform-tck-artifact</id>
      <activation>
        <property><name>tck.artifact</name></property>
      </activation>
      <modules><module>run</module></modules>
      <dependencies>
        <dependency>
          <groupId>jakarta.tck</groupId>
          <artifactId>${tck.artifact}</artifactId>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
