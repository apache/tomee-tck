<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.tomee.cts</groupId>
    <artifactId>runner-webprofile</artifactId>
    <version>11.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>runner-webprofile-run</artifactId>
  <name>Selected Jakarta EE 11 Web Profile TCK artifact runner</name>

  <dependencies>
    <dependency>
      <groupId>org.apache.tomee.cts</groupId>
      <artifactId>tomee-porting</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.tomee</groupId>
      <artifactId>arquillian-tomee-remote</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.arquillian.junit5</groupId>
      <artifactId>arquillian-junit5-container</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.derby</groupId>
      <artifactId>derbyclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.derby</groupId>
      <artifactId>derbyshared</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.derby</groupId>
      <artifactId>derbytools</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.derby</groupId>
      <artifactId>derbynet</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
        <filtering>true</filtering>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>stage-tomee-configuration</id>
            <phase>generate-test-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/tomee-overlay/conf</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../../environment/tomee/conf</directory>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>stage-derby-client</id>
            <phase>generate-test-resources</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <includeGroupIds>org.apache.derby</includeGroupIds>
              <includeArtifactIds>derbyclient,derbyshared,derbytools</includeArtifactIds>
              <includeScope>test</includeScope>
              <outputDirectory>${project.build.directory}/tomee-overlay/lib</outputDirectory>
              <overWriteIfNewer>true</overWriteIfNewer>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>reset-generated-test-environment</id>
            <phase>initialize</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>sh</executable>
              <arguments>
                <argument>${project.basedir}/../../environment/reset-generated-test-environment.sh</argument>
                <argument>${project.build.directory}/tomee-overlay</argument>
                <argument>${project.build.directory}/derby</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>require-free-derby-port</id>
            <phase>validate</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>sh</executable>
              <arguments>
                <argument>${project.basedir}/../../environment/database/require-derby-port-free.sh</argument>
                <argument>${java.home}/bin/java</argument>
                <classpath/>
              </arguments>
              <classpathScope>test</classpathScope>
            </configuration>
          </execution>
          <execution>
            <id>generate-test-certificates</id>
            <phase>generate-test-resources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>sh</executable>
              <arguments>
                <argument>${project.basedir}/../../environment/certificates/generate-test-certificates.sh</argument>
                <argument>${project.build.directory}/tomee-overlay/conf</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>start-derby</id>
            <phase>pre-integration-test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${java.home}/bin/java</executable>
              <classpathScope>test</classpathScope>
              <async>true</async>
              <asyncDestroyOnShutdown>true</asyncDestroyOnShutdown>
              <arguments>
                <argument>-Dderby.system.home=${project.build.directory}/derby</argument>
                <argument>-cp</argument>
                <classpath/>
                <argument>org.apache.derby.drda.NetworkServerControl</argument>
                <argument>start</argument>
                <argument>-h</argument><argument>localhost</argument>
                <argument>-noSecurityManager</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>wait-for-derby</id>
            <phase>pre-integration-test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>sh</executable>
              <arguments>
                <argument>${project.basedir}/../../environment/database/wait-for-derby.sh</argument>
                <argument>${java.home}/bin/java</argument>
                <classpath/>
              </arguments>
              <classpathScope>test</classpathScope>
            </configuration>
          </execution>
          <execution>
            <id>stop-derby</id>
            <phase>post-integration-test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${java.home}/bin/java</executable>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>-cp</argument>
                <classpath/>
                <argument>org.apache.derby.drda.NetworkServerControl</argument>
                <argument>shutdown</argument>
                <argument>-h</argument><argument>localhost</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>require-explicit-tck-test</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireProperty>
                  <property>tck.test</property>
                  <message>Set -Dtck.test to one test class or a narrow Failsafe pattern.</message>
                  <regex>.+</regex>
                </requireProperty>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${maven.surefire.plugin.version}</version>
        <configuration>
          <dependenciesToScan>
            <dependency>${tck.scan}</dependency>
          </dependenciesToScan>
          <includes>
            <include>${tck.test}</include>
          </includes>
          <failIfNoTests>true</failIfNoTests>
          <systemPropertyVariables>
            <webServerHost>${tck.host}</webServerHost>
            <webServerPort>${tck.http.port}</webServerPort>
            <junit.log.traceflag>${tck.trace}</junit.log.traceflag>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <id>run-selected-tck-test</id>
            <goals><goal>integration-test</goal><goal>verify</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <properties>
    <tck.host>localhost</tck.host>
    <tck.http.port>8080</tck.http.port>
    <tck.trace>false</tck.trace>
  </properties>
</project>
