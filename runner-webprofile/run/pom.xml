<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.tomee.cts</groupId>
    <artifactId>runner-webprofile</artifactId>
    <version>11.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>runner-webprofile-run</artifactId>
  <name>Selected Jakarta EE 11 Web Profile TCK artifact runner</name>

  <dependencies>
    <dependency>
      <groupId>org.apache.tomee.cts</groupId>
      <artifactId>tomee-porting</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.tomee</groupId>
      <artifactId>arquillian-tomee-remote</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- TomEE's remote adapter declares this provided but may serialize its exceptions. -->
    <dependency>
      <groupId>org.apache.openwebbeans</groupId>
      <artifactId>openwebbeans-impl</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.arquillian.junit5</groupId>
      <artifactId>arquillian-junit5-container</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The Platform WebSocket tests are client-side and require a provider. -->
    <dependency>
      <groupId>org.apache.tomcat</groupId>
      <artifactId>tomcat-websocket</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.tomcat</groupId>
      <artifactId>tomcat-api</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Client-only EL tests require the implementation named by the TCK. -->
    <dependency>
      <groupId>org.apache.tomcat</groupId>
      <artifactId>tomcat-jasper-el</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Reference providers used directly by Platform TCK client code. -->
    <dependency>
      <groupId>org.apache.johnzon</groupId>
      <artifactId>johnzon-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.johnzon</groupId>
      <artifactId>johnzon-jsonb</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.cxf</groupId>
      <artifactId>cxf-rt-rs-client</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.derby</groupId>
      <artifactId>derbyclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.derby</groupId>
      <artifactId>derbyshared</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.derby</groupId>
      <artifactId>derbytools</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.derby</groupId>
      <artifactId>derbynet</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.tck</groupId>
      <artifactId>persistence-platform-tck-dbprocedures</artifactId>
      <version>${jakarta.tck.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <testResources>
      <testResource>
        <directory>src/test/resources-${tck.protocol}</directory>
        <filtering>true</filtering>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>stage-tomee-configuration</id>
            <phase>generate-test-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/tomee-overlay/conf</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../../environment/tomee/conf</directory>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>resolve-tomee-distribution</id>
            <phase>generate-test-resources</phase>
            <goals><goal>get</goal></goals>
            <configuration>
              <artifact>org.apache.tomee:apache-tomee:${tomee.version}:zip:${tomee.classifier}</artifact>
              <transitive>false</transitive>
            </configuration>
          </execution>
          <execution>
            <id>stage-derby-client</id>
            <phase>generate-test-resources</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <includeGroupIds>org.apache.derby</includeGroupIds>
              <includeArtifactIds>derbyclient,derbyshared,derbytools</includeArtifactIds>
              <includeScope>test</includeScope>
              <outputDirectory>${project.build.directory}/tomee-overlay/lib</outputDirectory>
              <overWriteIfNewer>true</overWriteIfNewer>
            </configuration>
          </execution>
          <execution>
            <id>replace-legacy-tags-implementation</id>
            <phase>generate-test-resources</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.glassfish.web</groupId>
                  <artifactId>jakarta.servlet.jsp.jstl</artifactId>
                  <version>${jakarta.tags.impl.version}</version>
                  <!-- Overwrite the legacy JSTL jar shipped by TomEE. -->
                  <destFileName>taglibs-shade-${tomee.version}.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>jakarta.servlet.jsp.jstl</groupId>
                  <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
                  <version>${jakarta.tags.api.version}</version>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}/tomee-overlay/lib</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>reset-generated-test-environment</id>
            <phase>initialize</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>sh</executable>
              <arguments>
                <argument>${project.basedir}/../../environment/reset-generated-test-environment.sh</argument>
                <argument>${project.build.directory}/tomee-overlay</argument>
                <argument>${project.build.directory}/derby</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>require-free-derby-port</id>
            <phase>validate</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>sh</executable>
              <arguments>
                <argument>${project.basedir}/../../environment/database/require-derby-port-free.sh</argument>
                <argument>${java.home}/bin/java</argument>
                <classpath/>
              </arguments>
              <classpathScope>test</classpathScope>
            </configuration>
          </execution>
          <execution>
            <id>generate-test-certificates</id>
            <phase>generate-test-resources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>sh</executable>
              <arguments>
                <argument>${project.basedir}/../../environment/certificates/generate-test-certificates.sh</argument>
                <argument>${project.build.directory}/tomee-overlay/conf</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>start-derby</id>
            <phase>pre-integration-test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${java.home}/bin/java</executable>
              <classpathScope>test</classpathScope>
              <async>true</async>
              <asyncDestroyOnShutdown>true</asyncDestroyOnShutdown>
              <arguments>
                <argument>-Dderby.system.home=${project.build.directory}/derby</argument>
                <argument>-cp</argument>
                <classpath/>
                <argument>org.apache.derby.drda.NetworkServerControl</argument>
                <argument>start</argument>
                <argument>-h</argument><argument>localhost</argument>
                <argument>-noSecurityManager</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>wait-for-derby</id>
            <phase>pre-integration-test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>sh</executable>
              <arguments>
                <argument>${project.basedir}/../../environment/database/wait-for-derby.sh</argument>
                <argument>${java.home}/bin/java</argument>
                <classpath/>
              </arguments>
              <classpathScope>test</classpathScope>
            </configuration>
          </execution>
          <execution>
            <id>stop-derby</id>
            <phase>post-integration-test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${java.home}/bin/java</executable>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>-cp</argument>
                <classpath/>
                <argument>org.apache.derby.drda.NetworkServerControl</argument>
                <argument>shutdown</argument>
                <argument>-h</argument><argument>localhost</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>sql-maven-plugin</artifactId>
        <version>3.0.0</version>
        <configuration>
          <driver>org.apache.derby.jdbc.ClientDriver</driver>
          <url>jdbc:derby://localhost:1527/derbyDB;create=true</url>
          <username>CTS1</username>
          <password>CTS1</password>
          <autocommit>true</autocommit>
          <delimiter>;</delimiter>
          <onError>abort</onError>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.apache.derby</groupId>
            <artifactId>derbyclient</artifactId>
            <version>${derby.version}</version>
          </dependency>
          <dependency>
            <groupId>org.apache.derby</groupId>
            <artifactId>derbytools</artifactId>
            <version>${derby.version}</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>initialize-tck-database-schema</id>
            <phase>pre-integration-test</phase>
            <goals><goal>execute</goal></goals>
            <configuration>
              <sqlCommand>CREATE SCHEMA CTS1 AUTHORIZATION CTS1;</sqlCommand>
            </configuration>
          </execution>
          <execution>
            <id>initialize-platform-tck-database</id>
            <phase>pre-integration-test</phase>
            <goals><goal>execute</goal></goals>
            <configuration>
              <srcFiles>
                <srcFile>${project.basedir}/../../environment/database/jdbc-derby.ddl.sql</srcFile>
              </srcFiles>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>require-suite-partition</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireProperty>
                  <property>tck.artifact</property>
                  <message>Use run-platform-suite.sh or set -Dtck.artifact.</message>
                  <regex>.+</regex>
                </requireProperty>
                <requireProperty>
                  <property>tck.partition</property>
                  <message>Use run-platform-suite.sh or set -Dtck.partition.</message>
                  <regex>.+</regex>
                </requireProperty>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${maven.surefire.plugin.version}</version>
        <configuration>
          <argLine>
            -Djavax.net.ssl.keyStore=${project.build.directory}/tomee-overlay/conf/clientcert.p12
            -Djavax.net.ssl.keyStorePassword=changeit
            -Djavax.net.ssl.keyStoreType=PKCS12
            -Djavax.net.ssl.trustStore=${project.build.directory}/tomee-overlay/conf/client-truststore.p12
            -Djavax.net.ssl.trustStorePassword=changeit
            -Djavax.net.ssl.trustStoreType=PKCS12
          </argLine>
          <dependenciesToScan>
            <dependency>jakarta.tck:${tck.artifact}</dependency>
          </dependenciesToScan>
          <groups>${tck.groups}</groups>
          <includes>
            <include>${tck.test}</include>
          </includes>
          <excludesFile>${tck.exclusions.file}</excludesFile>
          <!-- The manifest count guard still fails every unexpected empty selection. -->
          <failIfNoTests>false</failIfNoTests>
          <reportsDirectory>${project.build.directory}/failsafe-reports/${tck.partition}</reportsDirectory>
          <summaryFile>${project.build.directory}/failsafe-reports/${tck.partition}/failsafe-summary.xml</summaryFile>
          <systemPropertyVariables>
            <webServerHost>${tck.host}</webServerHost>
            <webServerPort>${tck.http.port}</webServerPort>
            <user>j2ee</user>
            <password>j2ee</password>
            <jstl.db.url>jdbc:derby://localhost:1527/derbyDB;create=true</jstl.db.url>
            <jstl.db.user>cts1</jstl.db.user>
            <jstl.db.password>cts1</jstl.db.password>
            <jstl.db.driver>org.apache.derby.jdbc.ClientDriver</jstl.db.driver>
            <authuser>javajoe</authuser>
            <authpassword>javajoe</authpassword>
            <signature.bin.dir>${project.build.directory}/signature/com/sun/ts/tests/signaturetest/signature-repository</signature.bin.dir>
            <signature.classpath>${signature.classpath}</signature.classpath>
            <tck.ts.home>${tck.ts.home}</tck.ts.home>
            <securedWebServicePort>8443</securedWebServicePort>
            <ws_wait>5</ws_wait>
            <servlet_adaptor>org.apache.openejb.server.rest.OpenEJBRestServlet</servlet_adaptor>
            <org.apache.cxf.transport.http.forceURLConnection>true</org.apache.cxf.transport.http.forceURLConnection>
            <openejb.jaxrs.fail-on-constrainedto>false</openejb.jaxrs.fail-on-constrainedto>
            <ts_home>${project.build.directory}</ts_home>
            <junit.log.traceflag>${tck.trace}</junit.log.traceflag>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <id>run-selected-tck-test</id>
            <goals><goal>integration-test</goal><goal>verify</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <properties>
    <!-- Exclusions are TomEE-distribution-specific; run-platform-suite.sh
         selects exclusions/<classifier>/<partition>.txt when it exists. -->
    <tck.exclusions.file>${project.basedir}/../exclusions/${tck.partition}.txt</tck.exclusions.file>
    <tck.protocol>servlet</tck.protocol>
    <tck.test>**/*IT.java</tck.test>
    <tck.groups>web &amp; !tck-javatest</tck.groups>
    <tck.host>localhost</tck.host>
    <tck.http.port>8080</tck.http.port>
    <tck.trace>false</tck.trace>
    <tck.ts.home>${java.io.tmpdir}</tck.ts.home>
  </properties>

  <profiles>
    <profile>
      <id>signature-runtime</id>
      <activation>
        <property>
          <name>tck.partition</name>
          <value>signature</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>stage-signature-runtime</id>
                <phase>generate-test-resources</phase>
                <goals><goal>copy-dependencies</goal></goals>
                <configuration>
                  <includeGroupIds>jakarta.tck</includeGroupIds>
                  <includeArtifactIds>common,signaturetest,sigtest-maven-plugin</includeArtifactIds>
                  <includeScope>test</includeScope>
                  <outputDirectory>${project.build.directory}/tomee-overlay/lib</outputDirectory>
                  <overWriteIfNewer>true</overWriteIfNewer>
                </configuration>
              </execution>
              <execution>
                <id>stage-signature-metadata</id>
                <phase>generate-test-resources</phase>
                <goals><goal>unpack</goal></goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>jakarta.tck</groupId>
                      <artifactId>signaturevalidation</artifactId>
                      <version>${jakarta.tck.version}</version>
                      <outputDirectory>${project.build.directory}/signature</outputDirectory>
                      <includes>**/sig-test.map,**/sig-test-pkg-list.txt</includes>
                    </artifactItem>
                    <artifactItem>
                      <groupId>jakarta.tck</groupId>
                      <artifactId>signaturevalidation</artifactId>
                      <version>${jakarta.tck.version}</version>
                      <outputDirectory>${project.build.directory}/signature/src</outputDirectory>
                      <includes>**/*.sig</includes>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.apache.tomee</groupId>
                      <artifactId>apache-tomee</artifactId>
                      <version>${tomee.version}</version>
                      <classifier>${tomee.classifier}</classifier>
                      <type>zip</type>
                      <outputDirectory>${project.build.directory}/signature/tomee</outputDirectory>
                      <includes>**/lib/*.jar</includes>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>build-signature-classpath</id>
                <phase>generate-test-resources</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <exportAntProperties>true</exportAntProperties>
                  <target>
                    <path id="tomee-api-classpath">
                      <fileset dir="${project.build.directory}/signature/tomee/apache-tomee-${tomee.classifier}-${tomee.version}/lib">
                        <include name="jakarta*.jar"/>
                        <include name="el-api.jar"/>
                        <include name="jaspic-api.jar"/>
                        <include name="jsp-api.jar"/>
                        <include name="myfaces-api-*.jar"/>
                        <include name="servlet-api.jar"/>
                        <include name="websocket-api.jar"/>
                        <include name="websocket-client-api.jar"/>
                      </fileset>
                      <!-- The adapter replaces the distribution's legacy JSTL jar. -->
                      <fileset dir="${project.build.directory}/tomee-overlay/lib">
                        <include name="jakarta.servlet.jsp.jstl-api-*.jar"/>
                        <include name="taglibs-shade-${tomee.version}.jar"/>
                      </fileset>
                    </path>
                    <pathconvert pathsep="${path.separator}"
                                 property="signature.classpath"
                                 refid="tomee-api-classpath"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
      <properties>
        <tck.ts.home>${project.build.directory}/signature</tck.ts.home>
      </properties>
    </profile>
    <profile>
      <id>jdbc-database</id>
      <activation>
        <property>
          <name>tck.partition</name>
          <value>jdbc</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>sql-maven-plugin</artifactId>
            <version>3.0.0</version>
            <configuration>
              <driver>org.apache.derby.jdbc.ClientDriver</driver>
              <url>jdbc:derby://localhost:1527/derbyDB;create=true</url>
              <username>CTS1</username>
              <password>CTS1</password>
              <autocommit>true</autocommit>
              <delimiter>;</delimiter>
              <onError>abort</onError>
            </configuration>
            <dependencies>
              <dependency>
                <groupId>org.apache.derby</groupId>
                <artifactId>derbyclient</artifactId>
                <version>${derby.version}</version>
              </dependency>
              <dependency>
                <groupId>org.apache.derby</groupId>
                <artifactId>derbytools</artifactId>
                <version>${derby.version}</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>initialize-jdbc-tck-database</id>
                <phase>pre-integration-test</phase>
                <goals><goal>execute</goal></goals>
                <configuration>
                  <srcFiles>
                    <srcFile>${project.basedir}/../../environment/database/jdbc-derby.ddl.sprocs.sql</srcFile>
                  </srcFiles>
                  <sqlCommand>CALL sqlj.install_jar('${settings.localRepository}/jakarta/tck/jdbc-platform-tck/${jakarta.tck.version}/jdbc-platform-tck-${jakarta.tck.version}.jar', 'CTS1.CS_Procs', 0);
CALL SYSCS_UTIL.SYSCS_SET_DATABASE_PROPERTY('derby.database.classpath', 'CTS1.CS_Procs');</sqlCommand>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>persistence-database</id>
      <activation>
        <property>
          <name>tck.partition</name>
          <value>persistence-javatest</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>sql-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>initialize-persistence-tck-database</id>
                <phase>pre-integration-test</phase>
                <goals><goal>execute</goal></goals>
                <configuration>
                  <srcFiles>
                    <srcFile>${project.basedir}/../../environment/database/persistence-derby.ddl.sql</srcFile>
                  </srcFiles>
                  <sqlCommand>CALL sqlj.install_jar('${settings.localRepository}/jakarta/tck/persistence-platform-tck-dbprocedures/${jakarta.tck.version}/persistence-platform-tck-dbprocedures-${jakarta.tck.version}.jar', 'CTS1.Persistence_Procs', 0);
CALL SYSCS_UTIL.SYSCS_SET_DATABASE_PROPERTY('derby.database.classpath', 'CTS1.Persistence_Procs');</sqlCommand>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>javatest-protocol</id>
      <activation>
        <property>
          <name>tck.protocol</name>
          <value>javatest</value>
        </property>
      </activation>
      <properties>
        <tck.test>**/*Test.java</tck.test>
      </properties>
      <dependencies>
        <dependency>
          <groupId>jakarta.tck.arquillian</groupId>
          <artifactId>arquillian-protocol-javatest</artifactId>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
